APP_ENV=dev
APP_URL=http://localhost:8000

# Set to true in production behind HTTPS so the session cookie carries
# the Secure flag, browsers will then refuse to send it over plain HTTP.
COOKIE_SECURE=false

# Secret used to sign remember-me cookies. A 64-char hex string.
# Required when the remember_me authenticator is enabled.
REMEMBER_ME_SECRET=

# Session storage for long-lived workers. Default is file — var/sessions,
# fine for a single server. Use redis once you run multiple servers or
# containers; it requires the phpredis extension or predis/predis.
#SESSION_DRIVER=redis
#REDIS_URL=redis://127.0.0.1:6379

