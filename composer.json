{
    "name": "modufolio/appkit-skeleton",
    "description": "Minimal AppKit skeleton — a starting point for new applications.",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Maarten Thiebou"
        }
    ],
    "require": {
        "php": "^8.2",
        "modufolio/appkit": "^0.3",
        "modufolio/http": "^0.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.37",
        "phpstan/phpstan-doctrine": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t public/ router.php"
        ],
        "test": "vendor/bin/phpunit --no-coverage",
        "stan": "@php -d memory_limit=1G vendor/bin/phpstan analyse --configuration phpstan.php",
        "fix": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
