{
    "name": "modufolio/appkit-roadrunner",
    "description": "AppKit on RoadRunner — a starting point for applications on long-lived PHP workers.",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Maarten Thiebou"
        }
    ],
    "require": {
        "php": "^8.2",
        "modufolio/appkit": "^0.15",
        "modufolio/http": "^0.2",
        "spiral/roadrunner": "^2025.1",
        "spiral/roadrunner-cli": "^2.7",
        "spiral/roadrunner-http": "^4.1",
        "spiral/roadrunner-jobs": "^4.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t public/ router.php"
        ],
        "test": "vendor/bin/phpunit --no-coverage",
        "stan": "@php -d memory_limit=1G vendor/bin/phpstan analyse --configuration phpstan.php",
        "fix": "vendor/bin/php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
